                                           "format":  "table",
                                           "rawQuery":  true,
                                           "rawSql":  "SELECT\r\n    d.created_at AS \"Time\",\r\n    f.src_ip AS \"Source IP\",\r\n    f.dst_ip AS \"Destination IP\",\r\n    d.predicted_class AS \"Attack Type\",\r\n    ROUND(d.confidence::numeric, 3) AS \"Confidence\",\r\n    d.model_version AS \"Model Version\"\r\nFROM detections d\r\nJOIN flows f ON d.flow_id = f.id\r\nWHERE d.is_alert = TRUE\r\n  AND d.model_version = \u0027synthetic-fr20-v1\u0027\r\n  AND $__timeFilter(d.created_at)\r\nORDER BY d.created_at DESC\r\nLIMIT 100;",
